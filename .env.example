# Public URL of the site (used for Stripe redirect URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys (use test keys in development)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret — from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or the webhook endpoint in your Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Where orders and uploaded assets are stored (must be durable storage in production)
DATA_DIR=.data

# Optional — order confirmation emails via Resend (https://resend.com). If unset, emails are logged.
RESEND_API_KEY=
EMAIL_FROM="Masion Web Studio <hello@masionwebstudio.com>"
# Optional — receive a notification for every new order
STUDIO_NOTIFICATION_EMAIL=
