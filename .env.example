# Copy to .env.local for `npm run dev` / `npm start`. Never commit real values.
# On Cloudflare, set these in the Worker (Settings → Variables and Secrets) instead; see docs/DEPLOYMENT.md.

# Public URL of the site, no trailing slash. Used for Stripe return URLs, canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys. Use TEST keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) — from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or from the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Only used off Cloudflare (plain Node hosting): where orders and uploads are written.
# Must be a persistent, backed-up, private disk. On Cloudflare, the R2 bucket binding MASION_DATA is used instead.
DATA_DIR=.data

# Optional — confirmation emails via Resend (https://resend.com). Without a key, emails are NOT sent;
# a one-line notice with a masked address is logged instead.
RESEND_API_KEY=
EMAIL_FROM="Maison Web Studio <hello@maisonwebstudio.com>"
# Optional — address that receives a notification for every paid order.
STUDIO_NOTIFICATION_EMAIL=
