{
  "name": "masion-web-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "studio:typecheck": "tsc -p studio/tsconfig.json",
    "studio:test": "playwright test --project=studio",
    "studio:e2e": "cd studio && playwright test -c playwright.e2e.config.ts",
    "studio:dev": "wrangler dev -c studio/wrangler.jsonc",
    "studio:deploy": "wrangler deploy -c studio/wrangler.jsonc",
    "studio:migrate": "wrangler d1 migrations apply maison-studio --remote -c studio/wrangler.jsonc",
    "studio:ci-deploy": "wrangler d1 migrations apply maison-studio --remote -c studio/wrangler.jsonc && wrangler deploy -c studio/wrangler.jsonc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@noble/hashes": "2.4.0",
    "@opennextjs/cloudflare": "1.20.12",
    "hono": "4.13.13",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
